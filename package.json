{
  "name": "dwssr1-2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "npm run build",
    "start": "NODE_ENV=production node ./server/bin/www.js",
    "dev": "NODE_ENV=development PORT=3001 DEBUG=dwssr1-2026:* nodemon --watch server --ext js,mjs,cjs,json ./server/bin/www.js",
    "dev:vite": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:vite\"",
    "build": "vite build",
    "preview": "npm run build && vite start",
    "greet": "echo 'Hola mundo'",
    "lint:back": "eslint \"server/**/*.js\"",
    "lint:front": "eslint \"src/**/*.js\" ",
    "lint:config": "eslint \"vite.config.js\"",
    "lint:all": "npm run lint:back && npm run lint:front && npm run lint:config",
    "lint:fix": "eslint --fix \"server/**/*.js\" \"src/**/*.js\" \"vite.config.js\"",
    "format": "prettier --write \"server/**/*.js\" \"src/**/*.js\" \"vite.config.js\" \".eslintrc.cjs\"",
    "format:check": "prettier --check \"server/**/*.js\" \"src/**/*.js\" \"vite.config.js\" \".eslintrc.cjs\""
  },
  "dependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.6",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "hbs": "~4.0.4",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.21"
  },
  "imports": {
    "#server/*": "./server/*",
    "#routes/*": "./server/routes/*",
    "#lib/*": "./server/lib/*"
  }
}
